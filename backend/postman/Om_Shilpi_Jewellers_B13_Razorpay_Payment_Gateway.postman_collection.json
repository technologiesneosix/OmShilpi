{
  "info": {
    "_postman_id": "b13-razorpay-payment-gateway-om-shilpi",
    "name": "Om Shilpi Jewellers — B13 Razorpay Payment Gateway",
    "description": "Exhaustive API collection for Phase B13 Razorpay Payment Gateway Integration including Create Order, Payment Verification, Webhook Raw-Body Handling, Signature Verification, and Idempotency.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Razorpay Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/create-order",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "create-order"]
            }
          }
        },
        {
          "name": "Verify Payment Signature",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"razorpay_payment_id\": \"pay_test_12345\",\n  \"razorpay_order_id\": \"{{razorpayOrderId}}\",\n  \"razorpay_signature\": \"{{signature}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "verify"]
            }
          }
        },
        {
          "name": "Razorpay Webhook (Raw Body)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Razorpay-Signature", "value": "{{webhookSignature}}" },
              { "key": "X-Razorpay-Event-Id", "value": "evt_test_12345" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"event_id\": \"evt_test_12345\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_wh_12345\",\n        \"order_id\": \"{{razorpayOrderId}}\",\n        \"amount\": 15000000,\n        \"currency\": \"INR\",\n        \"status\": \"captured\"\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/webhook/razorpay",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "webhook", "razorpay"]
            }
          }
        }
      ]
    }
  ]
}
