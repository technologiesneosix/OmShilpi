{
  "info": {
    "_postman_id": "b16-contact-enquiry-system-collection",
    "name": "Om Shilpi Jewellers - B16 Contact & Enquiry System",
    "description": "Postman test collection for Phase B16 Contact & Enquiry System covering Public Enquiry Submission (POST /api/v1/enquiries), Input Validation, XSS Safety, Admin Enquiry Listing (GET /api/v1/admin/enquiries), Admin Status Update (PATCH /api/v1/admin/enquiries/:id), Status Workflow (NEW -> IN_PROGRESS -> RESOLVED -> CLOSED), RBAC Authorization, and B1-B15 Regression.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Public Submit Enquiry - Success (201 Created)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Customer B16\",\n  \"email\": \"test.customer.b16@example.com\",\n  \"phone\": \"9876543210\",\n  \"subject\": \"Product Enquiry\",\n  \"message\": \"I would like more information about your gold jewellery collection.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/enquiries",
          "host": ["{{baseUrl}}"],
          "path": ["enquiries"]
        }
      }
    },
    {
