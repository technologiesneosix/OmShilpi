# ==============================================================================
# Om Shilpi Jewellers - Development Environment Reference (.env.example)
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000

# Client & Origin Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Aiven MySQL / Hostinger MySQL)
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED
DATABASE_URL=mysql://username:password@host:port/database_name?ssl-mode=REQUIRED

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=your_dev_access_secret_at_least_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_dev_refresh_secret_at_least_16_chars
JWT_REFRESH_EXPIRES_IN=7d

# Authentication Cookie Configuration
COOKIE_NAME=omshilpi_access_token
REFRESH_COOKIE_NAME=omshilpi_refresh_token
COOKIE_SECRET=your_dev_cookie_secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=om-shilpi/products

# Razorpay Payment Gateway Configuration (Standard Checkout Test/Live)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
RAZORPAY_CURRENCY=INR

# Resend Email Provider Configuration
RESEND_API_KEY=re_YOUR_API_KEY
CONTACT_RECEIVER_EMAIL=admin@omshilpiexample.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
