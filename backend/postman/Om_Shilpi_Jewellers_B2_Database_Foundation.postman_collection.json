{
  "info": {
    "_postman_id": "b2-database-foundation-om-shilpi",
    "name": "Om Shilpi Jewellers — B2 Database Foundation",
    "description": "API verification collection for Phase B2 (Aiven MySQL + Prisma Integration)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check (Database Connected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "health"]
        },
        "description": "Verifies backend runtime and live database connectivity."
      },
      "response": []
    },
    {
      "name": "Not Found Handler Test",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/non-existent-route",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "non-existent-route"]
        },
        "description": "Verifies 404 response handling for undefined endpoints."
      },
      "response": []
    },
    {
      "name": "Unsupported Method Test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "health"]
        },
        "description": "Verifies non-handled HTTP methods respond with 404/Not Found."
      },
      "response": []
    }
  ]
}
