    {
      "name": "07 XSS Payload Handling (Safely stored plain text)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"<script>alert('xss')</script>\",\n  \"email\": \"xss@example.com\",\n  \"subject\": \"<img src=x onerror=alert(1)>\",\n  \"message\": \"Testing safe plain text storage without executing HTML/JS.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/enquiries",
          "host": ["{{baseUrl}}"],
          "path": ["enquiries"]
        }
      }
    },
    {
