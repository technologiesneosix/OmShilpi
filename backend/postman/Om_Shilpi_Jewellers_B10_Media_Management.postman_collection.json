{
  "info": {
    "_postman_id": "b10-media-management-om-shilpi",
    "name": "Om Shilpi Jewellers — B10 Media & Image Management",
    "description": "Comprehensive Postman test collection for Phase B10 Product Media & Image Management (Cloudinary Uploads, Metadata Synchronization, Atomic Primary Switching, Image Reordering, Replacement & Deletion)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Admin Media Operations",
      "item": [
        {
          "name": "Upload Product Image",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": [] },
                { "key": "altText", "value": "Front View Gold Ring", "type": "text" },
                { "key": "isPrimary", "value": "true", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:productId/images", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":productId", "images"] }
          }
        },
        {
          "name": "List Product Images",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:productId/images", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":productId", "images"] }
          }
        },
        {
          "name": "Set Primary Image",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:productId/images/:imageId/primary", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":productId", "images", ":imageId", "primary"] }
          }
        },
        {
          "name": "Reorder Images",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"imageIds\": [\"imageId2\", \"imageId1\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:productId/images/reorder", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":productId", "images", "reorder"] }
          }
        },
        {
          "name": "Update Image Metadata",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"altText\": \"Updated High-Resolution Front View\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:productId/images/:imageId", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":productId", "images", ":imageId"] }
          }
        },
        {
          "name": "Replace Image File",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:productId/images/:imageId/replace", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":productId", "images", ":imageId", "replace"] }
          }
        },
        {
          "name": "Delete Image",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:productId/images/:imageId", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":productId", "images", ":imageId"] }
          }
        }
      ]
    },
    {
      "name": "Public Media",
      "item": [
        {
          "name": "Get Public Product Detail with Ordered Images",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/products/:slug", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products", ":slug"] }
          }
        }
      ]
    },
    {
      "name": "Authorization",
      "item": [
        {
          "name": "Customer Upload Forbidden (403)",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "image", "type": "file", "src": [] }] },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:productId/images", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":productId", "images"] }
          }
        },
        {
          "name": "Unauthenticated Upload Forbidden (401)",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:productId/images", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":productId", "images"] }
          }
        }
      ]
    },
    {
      "name": "Validation & Constraints",
      "item": [
        {
          "name": "Nonexistent Product (404)",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "image", "type": "file", "src": [] }] },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/non-existent-product/images", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", "non-existent-product", "images"] }
          }
        },
        {
          "name": "Image Limit Reached (409)",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "image", "type": "file", "src": [] }] },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:productId/images", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":productId", "images"] }
          }
        }
      ]
    },
    {
      "name": "Regression",
      "item": [
        {
          "name": "Health B2",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/health", "host": ["{{baseUrl}}"], "path": ["api", "v1", "health"] } }
        },
        {
          "name": "Categories B6",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/categories", "host": ["{{baseUrl}}"], "path": ["api", "v1", "categories"] } }
        },
        {
          "name": "Collections B7",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/collections", "host": ["{{baseUrl}}"], "path": ["api", "v1", "collections"] } }
        },
        {
          "name": "Products B8",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/products", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products"] } }
        },
        {
          "name": "Inventory B9",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/admin/inventory", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "inventory"] } }
        }
      ]
    }
  ]
}
