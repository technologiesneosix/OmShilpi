{
  "info": {
    "_postman_id": "b12-checkout-addresses-orders-om-shilpi",
    "name": "Om Shilpi Jewellers — B12 Checkout, Customer Addresses & Order Creation",
    "description": "Comprehensive Postman test collection for Phase B12 Customer Addresses, Checkout Preview, Server-Side Order Validation, Atomic Order Creation with Inventory Deduction & Cart Clearing, Order Cancellation, and Admin Order Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Customer Addresses",
      "item": [
        {
          "name": "Create Address",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Customer A Home\",\n  \"phone\": \"9876543210\",\n  \"addressLine1\": \"123 Jewellery Street\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"postalCode\": \"400001\",\n  \"country\": \"India\",\n  \"isDefault\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/addresses", "host": ["{{baseUrl}}"], "path": ["api", "v1", "addresses"] }
          }
        },
        {
          "name": "Get Customer Addresses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/addresses", "host": ["{{baseUrl}}"], "path": ["api", "v1", "addresses"] }
          }
        },
        {
          "name": "Get Address by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/addresses/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "addresses", ":id"] }
          }
        },
        {
          "name": "Update Address",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Customer A Updated Home\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/addresses/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "addresses", ":id"] }
          }
        },
        {
          "name": "Set Default Address",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/addresses/:id/default", "host": ["{{baseUrl}}"], "path": ["api", "v1", "addresses", ":id", "default"] }
          }
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/addresses/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "addresses", ":id"] }
          }
        }
      ]
    },
    {
      "name": "Checkout Preview",
      "item": [
        {
          "name": "Get Checkout Preview Summary",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"shippingAddressId\": \"{{addressId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/checkout/preview", "host": ["{{baseUrl}}"], "path": ["api", "v1", "checkout", "preview"] }
          }
        }
      ]
    },
    {
      "name": "Order Placement & History",
      "item": [
        {
          "name": "Create Order from Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"shippingAddressId\": \"{{addressId}}\",\n  \"notes\": \"Handle with care\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/orders", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders"] }
          }
        },
        {
          "name": "Get Customer Orders List",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/orders?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders"] }
          }
        },
        {
          "name": "Get Customer Order Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/orders/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", ":id"] }
          }
        },
        {
          "name": "Cancel Order (Restores Stock)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/orders/:id/cancel", "host": ["{{baseUrl}}"], "path": ["api", "v1", "orders", ":id", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "Admin Order Management",
      "item": [
