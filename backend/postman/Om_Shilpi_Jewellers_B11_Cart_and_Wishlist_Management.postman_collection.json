{
  "info": {
    "_postman_id": "b11-cart-wishlist-om-shilpi",
    "name": "Om Shilpi Jewellers — B11 Cart & Wishlist Management",
    "description": "Comprehensive Postman test collection for Phase B11 Customer Cart & Wishlist Management (Per-Customer Cart/Wishlist Isolation, Dynamic Backend Totals, Inventory Availability Checks, Atomic Increments, Ownership Security & Counts)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Customer Cart",
      "item": [
        {
          "name": "Get Customer Cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cart", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart"] }
          }
        },
        {
          "name": "Get Cart Count",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/cart/count", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "count"] }
          }
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/cart/items", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items"] }
          }
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/cart/items/:itemId", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items", ":itemId"] }
          }
        },
        {
          "name": "Remove Cart Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/cart/items/:itemId", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items", ":itemId"] }
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/cart", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart"] }
          }
        }
      ]
    },
    {
      "name": "Customer Wishlist",
      "item": [
        {
          "name": "Get Customer Wishlist",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/wishlist", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wishlist"] }
          }
        },
        {
          "name": "Get Wishlist Count",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/wishlist/count", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wishlist", "count"] }
          }
        },
        {
          "name": "Add Product to Wishlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/wishlist/items", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wishlist", "items"] }
          }
        },
        {
          "name": "Remove Wishlist Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/wishlist/items/:itemId", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wishlist", "items", ":itemId"] }
          }
        }
      ]
    },
    {
      "name": "Authorization & Ownership Security",
      "item": [
        {
          "name": "Cross Customer Cart Mutation (404)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 3\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/cart/items/customer-b-item-id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items", "customer-b-item-id"] }
          }
        },
        {
          "name": "Admin Cart Forbidden (403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/cart", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart"] }
          }
        },
        {
          "name": "Unauthenticated Cart Forbidden (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/cart", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart"] }
          }
        }
      ]
    },
    {
      "name": "Inventory & Stock Validation",
      "item": [
        {
          "name": "Out of Stock Product Add (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"out-of-stock-product-id\",\n  \"quantity\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/cart/items", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items"] }
          }
        },
        {
          "name": "Inactive Product Add (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"inactive-product-id\",\n  \"quantity\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/cart/items", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items"] }
          }
        },
        {
          "name": "Exceed Available Stock Update (400)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 999\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/cart/items/:itemId", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "items", ":itemId"] }
          }
        }
      ]
    },
    {
      "name": "Regression",
      "item": [
        {
          "name": "Health B2",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/health", "host": ["{{baseUrl}}"], "path": ["api", "v1", "health"] } }
        },
        {
          "name": "Categories B6",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/categories", "host": ["{{baseUrl}}"], "path": ["api", "v1", "categories"] } }
        },
        {
          "name": "Collections B7",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/collections", "host": ["{{baseUrl}}"], "path": ["api", "v1", "collections"] } }
        },
        {
          "name": "Products B8",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/products", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products"] } }
        },
        {
          "name": "Inventory B9",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/v1/admin/inventory", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "inventory"] } }
        }
      ]
    }
  ]
}
