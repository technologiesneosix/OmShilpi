        ],
        "url": {
          "raw": "{{baseUrl}}/admin/enquiries?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "enquiries"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
