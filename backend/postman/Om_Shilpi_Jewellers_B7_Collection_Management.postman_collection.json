{
  "info": {
    "_postman_id": "b7-collection-management-om-shilpi",
    "name": "Om Shilpi Jewellers — B7 Collection Management",
    "description": "Comprehensive Postman test collection for Phase B7 Collection Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "List Active Collections",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/collections", "host": ["{{baseUrl}}"], "path": ["api", "v1", "collections"] }
          }
        },
        {
          "name": "Get Collection by Slug",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/collections/b7-test-bridal-collection", "host": ["{{baseUrl}}"], "path": ["api", "v1", "collections", "b7-test-bridal-collection"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Create Collection",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"B7 Test Bridal Collection\",\n  \"slug\": \"b7-test-bridal-collection\",\n  \"description\": \"B7 test collection\",\n  \"sortOrder\": 100\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/collections", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "collections"] }
          }
        },
        {
          "name": "List Collections (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/collections?page=1&limit=10&status=all", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "collections"] }
          }
        },
        {
          "name": "Get Collection by ID (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/collections/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "collections", ":id"] }
          }
        },
        {
          "name": "Update Collection",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"B7 Updated Bridal Collection\",\n  \"description\": \"Updated description\",\n  \"sortOrder\": 50\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/collections/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "collections", ":id"] }
          }
        },
        {
          "name": "Deactivate or Delete Collection",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/collections/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "collections", ":id"] }
          }
        }
      ]
    },
    {
