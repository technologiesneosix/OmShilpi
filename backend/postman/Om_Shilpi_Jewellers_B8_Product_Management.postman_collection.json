{
  "info": {
    "_postman_id": "b8-product-management-om-shilpi",
    "name": "Om Shilpi Jewellers — B8 Product Management",
    "description": "Comprehensive Postman test collection for Phase B8 Product Management (Base Catalog, Specifications, Decimal Pricing, Category/Collection relations & Filtering)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/products", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products"] }
          }
        },
        {
          "name": "Product Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/products/b8-test-gold-necklace", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products", "b8-test-gold-necklace"] }
          }
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/products?search=gold", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products"] }
          }
        },
        {
          "name": "Category Filter",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/products?category=gold-jewellery", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products"] }
          }
        },
        {
          "name": "Collection Filter",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/products?collection=bridal-collection", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products"] }
          }
        },
        {
          "name": "Featured",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/products?featured=true", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products"] }
          }
        },
        {
          "name": "New Arrivals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/products?newArrival=true", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products"] }
          }
        },
        {
          "name": "Price Filter",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/products?minPrice=50000&maxPrice=100000", "host": ["{{baseUrl}}"], "path": ["api", "v1", "products"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"B8 Test Gold Necklace\",\n  \"slug\": \"b8-test-gold-necklace\",\n  \"sku\": \"OSJ-B8-GN-001\",\n  \"description\": \"B8 test jewellery product\",\n  \"price\": 85000.00,\n  \"metal\": \"Gold\",\n  \"purity\": \"22K\",\n  \"grossWeight\": 12.5,\n  \"isFeatured\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products"] }
          }
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products?page=1&limit=10&status=all", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products"] }
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":id"] }
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 89000.00,\n  \"description\": \"Updated description\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":id"] }
          }
        },
        {
          "name": "Deactivate",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":id"] }
          }
        },
        {
          "name": "Reactivate",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/products/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "products", ":id"] }
          }
        }
      ]
    },
