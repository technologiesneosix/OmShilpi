          }
        },
        {
          "name": "Admin Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/orders/:id/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "orders", ":id", "status"] }
          }
        }
      ]
    },
