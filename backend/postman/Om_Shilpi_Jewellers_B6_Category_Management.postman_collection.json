{
  "info": {
    "_postman_id": "b6-category-management-om-shilpi",
    "name": "Om Shilpi Jewellers — B6 Category Management",
    "description": "Comprehensive Postman test collection for Phase B6 Category Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "List Active Categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/categories", "host": ["{{baseUrl}}"], "path": ["api", "v1", "categories"] }
          }
        },
        {
          "name": "Get Category by Slug",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/categories/b6-test-gold-jewellery", "host": ["{{baseUrl}}"], "path": ["api", "v1", "categories", "b6-test-gold-jewellery"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"B6 Test Gold Jewellery\",\n  \"slug\": \"b6-test-gold-jewellery\",\n  \"description\": \"B6 test category\",\n  \"sortOrder\": 100\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/categories", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "categories"] }
          }
        },
        {
          "name": "List Categories (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/categories?page=1&limit=10&status=all", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "categories"] }
          }
        },
        {
          "name": "Get Category by ID (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/categories/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "categories", ":id"] }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"B6 Updated Gold Jewellery\",\n  \"description\": \"Updated description\",\n  \"sortOrder\": 50\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/categories/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "categories", ":id"] }
          }
        },
        {
          "name": "Deactivate or Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/categories/:id", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "categories", ":id"] }
          }
        }
      ]
    },
